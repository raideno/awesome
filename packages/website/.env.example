BASE=/

LIST_FILE_PATH=list.yaml

PLUGINS_DIRECTORY_PATH=plugins

REPOSITORY_DIRECTORY_PATH=./
REPOSITORY_BUNDLED_FILES=README.md,list.yaml
REPOSITORY_IGNORE=.git,node_modules,.DS_Store
REPOSITORY_PUBLIC_SUBDIR=repository

GITHUB_REPOSITORY_URL=https://github.com/<owner>/<repo>
GITHUB_WORKFLOW_REF=<owner>/<repo>/.github/workflows/<workflow-file>.yml@refs/heads/main

USER_REPOSITORY_COMMIT_HASH=xxx
AWESOME_WEBSITE_TAG=xxx
