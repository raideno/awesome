{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 192
    },
    "author": {
      "type": "string",
      "maxLength": 64
    },
    "thumbnail": {
      "type": "string"
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 8,
            "pattern": "^\\d+$"
          },
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 192
          },
          "link": {
            "type": "string",
            "format": "uri"
          },
          "tags": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "group": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "tags"
        ],
        "additionalProperties": {}
      }
    },
    "links": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  },
  "required": [
    "title",
    "description",
    "author",
    "elements"
  ],
  "additionalProperties": {}
}